# =============================================================================
# Filing Sleuth — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in the values.

# SEC EDGAR requires a descriptive User-Agent on every request.
# Format: "Your Name your-email@example.com"
# Requests without this WILL be blocked (403).
SEC_USER_AGENT="Your Name your-email@example.com"

# LLM Provider — at least one required
# Primary: Anthropic Claude Sonnet
ANTHROPIC_API_KEY=""
# Fallback / embeddings: OpenAI
OPENAI_API_KEY=""

# LLM model names (defaults shown — override if needed)
ANTHROPIC_MODEL="claude-sonnet-4-20250514"
OPENAI_MODEL="gpt-4o"

# Embedding model — "local" uses sentence-transformers (free, no API key)
# or "openai" uses text-embedding-3-small (requires OPENAI_API_KEY)
EMBEDDING_PROVIDER="local"
EMBEDDING_MODEL="all-MiniLM-L6-v2"

# Cache directory (relative to project root)
CACHE_DIR="cache_data"

# SEC rate limit (max requests per second — SEC allows up to 10)
SEC_RATE_LIMIT=8

# Logging level
LOG_LEVEL="INFO"
